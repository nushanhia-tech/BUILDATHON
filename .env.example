# Client (public) — Supabase: Project Settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Teachable Machine image model URL (ends with /), e.g. https://teachablemachine.withgoogle.com/models/abc123/
VITE_NOTE_MODEL_URL=

# Server only (Vercel env var, never prefixed with VITE_)
GEMINI_API_KEY=
# Optional: override the Gemini model
GEMINI_MODEL=gemini-2.5-flash
